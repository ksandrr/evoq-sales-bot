BOT_TOKEN=your_telegram_bot_token_from_botfather

# Optional: SQLite database path.
# Locally you can omit it; production deployments should use persistent storage.
# DB_PATH=/data/ideas.db

# Optional: default timezone for new users.
# DEFAULT_TIMEZONE=Asia/Omsk

# OpenAI secrets are intentionally not included in this file.
# Set OPENAI_API_KEY only in your local environment, server environment, or secret manager.
#
# Optional model overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_PARSE_MODEL=gpt-5.5

# Optional OpenAI STT overrides for voice transcription (primary).
# Keep these only in your real environment or secret manager.
# OPENAI_STT_API_KEY=sk-...
# OPENAI_STT_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_STT_ENABLED=true

# Optional Weeek integration.
# WEEEK_API_TOKEN=your_weeek_api_token
# WEEEK_API_BASE_URL=https://api.weeek.net/public/v1
# WEEEK_DEFAULT_WORKSPACE_ID=

# Optional Vosk overrides for local/offline voice recognition.
# VOSK_MODEL_PATH=/home/sanya/evoq-sales-bot/data/vosk-model
# VOSK_MODEL_URL=https://huggingface.co/rhasspy/vosk-models/resolve/main/ru/vosk-model-small-ru-0.22.zip
