BOT_TOKEN=your_telegram_bot_token_from_botfather

# Опционально: путь к файлу базы данных SQLite.
# Локально можно не указывать (по умолчанию ideas.db рядом с bot.py).
# На Railway укажи /data/ideas.db и примонтируй том на /data,
# иначе при каждом деплое идеи будут теряться.
# DB_PATH=/data/ideas.db

# Опционально: ключ OpenAI API для распознавания голосовых сообщений.
# Если задан — бот сможет принимать идеи голосом (Whisper + GPT-4o-mini).
# Получить ключ: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
